  "ko": {
    "description": {
      "mymod_hero": {
        "name": "영웅",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> <#ff9028ff>물리 피해<>를 줍니다. <#ffb900ff>3<>번째 공격마다 대신 <#ff9028ff>30<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 160%<> 피해를 줍니다.",
        "skill": "<#ff9028ff>검기<>: 앞으로 검기를 날려 적중한 모든 적에게 <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 90%<> <#ff9028ff>물리 피해<>를 주고 <#ffb900ff>1.5초<> 동안 30% <#ef5350ff>둔화<>시킵니다.",
        "skill2": "<#ff9028ff>수비 태세<>: <#ffb900ff>3초<> 동안 <#e8d44dff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 50%<>의 <#e8d44dff>보호막<>과 <i#asset/base/ui/banpick/champion_stat_icon:speed_0><#ffffffff>이동 속도 20%<>를 얻습니다.",
        "ult": "<#ff9028ff>마무리 일격<>: 대상 적 챔피언에게 도약해 주변 적에게 <#ff9028ff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 120%<> <#ff9028ff>물리 피해<>를 주고 <#ffb900ff>1초<> 동안 <#ef5350ff>기절<>시킵니다."
      }
    },
    "skill_name": {
      "mymod_hero": {
        "skill1": "검기",
        "skill2": "수비 태세",
        "ult": "마무리 일격"
